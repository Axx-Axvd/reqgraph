# Скопируй в .env и заполни. .env в git не попадает.
# Описание переменных: docs/tech-design/07_deploy.md

# --- модели ---
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
REQGRAPH_PROFILE=free            # free | cheap | local (llm/roles.yaml)
REQGRAPH_RUN_BUDGET_USD=0.50

# --- Supabase (локально: значения из `supabase status`) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=       # только для api, никогда во фронтенд
SUPABASE_JWKS_URL=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres   # в облаке: Supavisor session pooler :5432

# --- прочее ---
KROKI_URL=https://kroki.io
DEMO_RUNS_PER_DAY=3
DEMO_DAILY_USD_CAP=0.50
NEXT_PUBLIC_API_URL=http://localhost:8000
PYDANTIC_AI_NO_BANNER=1
