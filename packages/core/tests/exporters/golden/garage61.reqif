            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-XHTML-REF>SOT-REQUIREMENT-SCENARIO</ATTRIBUTE-DEFINITION-XHTML-REF>
              </DEFINITION>
              <THE-VALUE><xhtml:div><xhtml:p>1. открывает расписание на выбранный день</xhtml:p><xhtml:p>2. отмечает неявку, если клиент не приехал за 15 минут</xhtml:p><xhtml:p>3. переносит записи мастера, который не вышел на смену</xhtml:p></xhtml:div></THE-VALUE>
