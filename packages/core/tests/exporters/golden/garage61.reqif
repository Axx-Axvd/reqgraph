              <DEFINITION>
                <ATTRIBUTE-DEFINITION-XHTML-REF>SOT-REQUIREMENT-ReqIF.Name</ATTRIBUTE-DEFINITION-XHTML-REF>
              </DEFINITION>
              <THE-VALUE><xhtml:div><xhtml:p>Время онлайн-записи</xhtml:p></xhtml:div></THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-XHTML-REF>SOT-REQUIREMENT-ReqIF.Text</ATTRIBUTE-DEFINITION-XHTML-REF>
              </DEFINITION>
              <THE-VALUE><xhtml:div><xhtml:p>Новый клиент должен завершать онлайн-запись не более чем за 3 минуты в 90% попыток.</xhtml:p></xhtml:div></THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="reviewed">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>SOT-REQUIREMENT-STATUS</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="should">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>SOT-REQUIREMENT-PRIORITY</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-XHTML-REF>SOT-REQUIREMENT-METRIC</ATTRIBUTE-DEFINITION-XHTML-REF>
              </DEFINITION>
              <THE-VALUE><xhtml:div><xhtml:p>время от открытия сайта до подтверждения записи, 90-й процентиль &lt;= 3 мин</xhtml:p></xhtml:div></THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="interaction_capability">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>SOT-REQUIREMENT-QUALITY</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
          </VALUES>
          <TYPE>
            <SPEC-OBJECT-TYPE-REF>SOT-REQUIREMENT</SPEC-OBJECT-TYPE-REF>
          </TYPE>
