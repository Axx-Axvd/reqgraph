        <SPEC-OBJECT IDENTIFIER="REQ-UR-001" LAST-CHANGE="2026-11-02T12:00:00+00:00">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="UR-001">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>SOT-REQUIREMENT-ReqIF.ForeignID</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-XHTML-REF>SOT-REQUIREMENT-ReqIF.Name</ATTRIBUTE-DEFINITION-XHTML-REF>
              </DEFINITION>
              <THE-VALUE><xhtml:div><xhtml:p>Онлайн-запись частного клиента</xhtml:p></xhtml:div></THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-XHTML-REF>SOT-REQUIREMENT-ReqIF.Text</ATTRIBUTE-DEFINITION-XHTML-REF>
              </DEFINITION>
              <THE-VALUE><xhtml:div><xhtml:p>Частный клиент записывается на обслуживание через сайт без звонка администратору.</xhtml:p></xhtml:div></THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="reviewed">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>SOT-REQUIREMENT-STATUS</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="must">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>SOT-REQUIREMENT-PRIORITY</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-XHTML-REF>SOT-REQUIREMENT-SCENARIO</ATTRIBUTE-DEFINITION-XHTML-REF>
              </DEFINITION>
              <THE-VALUE><xhtml:div><xhtml:p>1. подтверждает номер телефона кодом из SMS</xhtml:p><xhtml:p>2. выбирает услугу из прайса</xhtml:p><xhtml:p>3. выбирает свободное время на ближайшие 14 дней</xhtml:p><xhtml:p>4. получает SMS с подтверждением записи</xhtml:p></xhtml:div></THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
          </VALUES>
          <TYPE>
            <SPEC-OBJECT-TYPE-REF>SOT-REQUIREMENT</SPEC-OBJECT-TYPE-REF>
          </TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="REQ-UR-002" LAST-CHANGE="2026-11-02T12:00:00+00:00">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="UR-002">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>SOT-REQUIREMENT-ReqIF.ForeignID</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-XHTML-REF>SOT-REQUIREMENT-ReqIF.Name</ATTRIBUTE-DEFINITION-XHTML-REF>
              </DEFINITION>
              <THE-VALUE><xhtml:div><xhtml:p>Напоминание и отмена</xhtml:p></xhtml:div></THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-XHTML-REF>SOT-REQUIREMENT-ReqIF.Text</ATTRIBUTE-DEFINITION-XHTML-REF>
              </DEFINITION>
              <THE-VALUE><xhtml:div><xhtml:p>Частный клиент получает напоминание о визите и может отменить запись не позднее чем за 2 часа до визита.</xhtml:p></xhtml:div></THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="reviewed">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>SOT-REQUIREMENT-STATUS</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="must">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>SOT-REQUIREMENT-PRIORITY</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-XHTML-REF>SOT-REQUIREMENT-SCENARIO</ATTRIBUTE-DEFINITION-XHTML-REF>
              </DEFINITION>
              <THE-VALUE><xhtml:div><xhtml:p>1. получает SMS-напоминание за 24 часа до визита</xhtml:p><xhtml:p>2. отвечает на SMS словом «отмена» или отменяет запись на сайте</xhtml:p></xhtml:div></THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
          </VALUES>
          <TYPE>
            <SPEC-OBJECT-TYPE-REF>SOT-REQUIREMENT</SPEC-OBJECT-TYPE-REF>
          </TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="REQ-UR-003" LAST-CHANGE="2026-11-02T12:00:00+00:00">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="UR-003">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>SOT-REQUIREMENT-ReqIF.ForeignID</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-XHTML-REF>SOT-REQUIREMENT-ReqIF.Name</ATTRIBUTE-DEFINITION-XHTML-REF>
              </DEFINITION>
              <THE-VALUE><xhtml:div><xhtml:p>Корпоративные записи по договору</xhtml:p></xhtml:div></THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-XHTML-REF>SOT-REQUIREMENT-ReqIF.Text</ATTRIBUTE-DEFINITION-XHTML-REF>
              </DEFINITION>
              <THE-VALUE><xhtml:div><xhtml:p>Менеджер автопарка записывает автомобили компании по договору и раз в месяц получает счёт с отсрочкой оплаты.</xhtml:p></xhtml:div></THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="reviewed">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>SOT-REQUIREMENT-STATUS</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="should">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>SOT-REQUIREMENT-PRIORITY</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-XHTML-REF>SOT-REQUIREMENT-SCENARIO</ATTRIBUTE-DEFINITION-XHTML-REF>
              </DEFINITION>
              <THE-VALUE><xhtml:div><xhtml:p>1. входит в личный кабинет компании</xhtml:p><xhtml:p>2. записывает несколько автомобилей без SMS-кода для каждой записи</xhtml:p><xhtml:p>3. получает счёт за прошлый месяц</xhtml:p></xhtml:div></THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
          </VALUES>
          <TYPE>
            <SPEC-OBJECT-TYPE-REF>SOT-REQUIREMENT</SPEC-OBJECT-TYPE-REF>
          </TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="REQ-UR-004" LAST-CHANGE="2026-11-02T12:00:00+00:00">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="UR-004">
