        <SPEC-OBJECT IDENTIFIER="REQ-BR-001" LAST-CHANGE="2026-11-02T12:00:00+00:00">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="BR-001">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>SOT-REQUIREMENT-ReqIF.ForeignID</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-XHTML-REF>SOT-REQUIREMENT-ReqIF.Name</ATTRIBUTE-DEFINITION-XHTML-REF>
              </DEFINITION>
              <THE-VALUE><xhtml:div><xhtml:p>Снизить долю неявок</xhtml:p></xhtml:div></THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-XHTML-REF>SOT-REQUIREMENT-ReqIF.Text</ATTRIBUTE-DEFINITION-XHTML-REF>
              </DEFINITION>
              <THE-VALUE><xhtml:div><xhtml:p>Доля неявок клиентов должна снизиться с 15% до 7% записей в течение 6 месяцев после запуска системы.</xhtml:p></xhtml:div></THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="reviewed">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>SOT-REQUIREMENT-STATUS</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="must">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>SOT-REQUIREMENT-PRIORITY</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-XHTML-REF>SOT-REQUIREMENT-GOAL</ATTRIBUTE-DEFINITION-XHTML-REF>
              </DEFINITION>
              <THE-VALUE><xhtml:div><xhtml:p>доля неявок от числа записей &lt;= 7 %</xhtml:p></xhtml:div></THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
          </VALUES>
          <TYPE>
            <SPEC-OBJECT-TYPE-REF>SOT-REQUIREMENT</SPEC-OBJECT-TYPE-REF>
          </TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="REQ-BR-002" LAST-CHANGE="2026-11-02T12:00:00+00:00">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="BR-002">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>SOT-REQUIREMENT-ReqIF.ForeignID</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-XHTML-REF>SOT-REQUIREMENT-ReqIF.Name</ATTRIBUTE-DEFINITION-XHTML-REF>
              </DEFINITION>
              <THE-VALUE><xhtml:div><xhtml:p>Перевести запись в онлайн</xhtml:p></xhtml:div></THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-XHTML-REF>SOT-REQUIREMENT-ReqIF.Text</ATTRIBUTE-DEFINITION-XHTML-REF>
              </DEFINITION>
              <THE-VALUE><xhtml:div><xhtml:p>Доля записей через онлайн-канал должна вырасти с 0% до 60% в течение 6 месяцев после запуска системы.</xhtml:p></xhtml:div></THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="reviewed">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>SOT-REQUIREMENT-STATUS</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="must">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>SOT-REQUIREMENT-PRIORITY</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-XHTML-REF>SOT-REQUIREMENT-GOAL</ATTRIBUTE-DEFINITION-XHTML-REF>
              </DEFINITION>
              <THE-VALUE><xhtml:div><xhtml:p>доля онлайн-записей &gt;= 60 %</xhtml:p></xhtml:div></THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
          </VALUES>
          <TYPE>
            <SPEC-OBJECT-TYPE-REF>SOT-REQUIREMENT</SPEC-OBJECT-TYPE-REF>
          </TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="REQ-BR-003" LAST-CHANGE="2026-11-02T12:00:00+00:00">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="BR-003">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>SOT-REQUIREMENT-ReqIF.ForeignID</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-XHTML-REF>SOT-REQUIREMENT-ReqIF.Name</ATTRIBUTE-DEFINITION-XHTML-REF>
              </DEFINITION>
              <THE-VALUE><xhtml:div><xhtml:p>Учёт корпоративных заказов без тетради</xhtml:p></xhtml:div></THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-XHTML-REF>SOT-REQUIREMENT-ReqIF.Text</ATTRIBUTE-DEFINITION-XHTML-REF>
              </DEFINITION>
              <THE-VALUE><xhtml:div><xhtml:p>Все заказы корпоративных клиентов по договорам должны учитываться в системе вместо бумажного журнала с первого месяца после запуска.</xhtml:p></xhtml:div></THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="reviewed">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>SOT-REQUIREMENT-STATUS</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="should">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>SOT-REQUIREMENT-PRIORITY</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-XHTML-REF>SOT-REQUIREMENT-GOAL</ATTRIBUTE-DEFINITION-XHTML-REF>
              </DEFINITION>
              <THE-VALUE><xhtml:div><xhtml:p>доля корпоративных заказов, учтённых в системе 100 %</xhtml:p></xhtml:div></THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
          </VALUES>
          <TYPE>
            <SPEC-OBJECT-TYPE-REF>SOT-REQUIREMENT</SPEC-OBJECT-TYPE-REF>
          </TYPE>
        </SPEC-OBJECT>
