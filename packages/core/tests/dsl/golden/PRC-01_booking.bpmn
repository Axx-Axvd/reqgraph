<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="PRC-01.definitions" targetNamespace="urn:reqgraph:process:PRC-01" exporter="reqgraph">
  <bpmn:collaboration id="PRC-01.collaboration">
    <bpmn:participant id="PRC-01.pool" name="Онлайн-запись частного клиента" processRef="PRC-01"/>
  </bpmn:collaboration>
  <bpmn:process id="PRC-01" name="Онлайн-запись частного клиента" isExecutable="false">
    <bpmn:laneSet id="PRC-01.lanes">
      <bpmn:lane id="PRC-01.L1" name="Клиент">
        <bpmn:flowNodeRef>PRC-01.S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PRC-01.T01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PRC-01.T02</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="PRC-01.L2" name="Система">
        <bpmn:flowNodeRef>PRC-01.G02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PRC-01.T03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PRC-01.G01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PRC-01.T04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PRC-01.T05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PRC-01.T06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PRC-01.E1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="PRC-01.S" name="Клиент открыл сайт">
      <bpmn:outgoing>PRC-01.F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="PRC-01.T01" name="Подтвердить телефон кодом из SMS">
      <bpmn:incoming>PRC-01.F01</bpmn:incoming>
      <bpmn:outgoing>PRC-01.F02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="PRC-01.T02" name="Выбрать услугу">
      <bpmn:incoming>PRC-01.F02</bpmn:incoming>
      <bpmn:outgoing>PRC-01.F03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="PRC-01.G02">
      <bpmn:incoming>PRC-01.F03</bpmn:incoming>
      <bpmn:incoming>PRC-01.F08</bpmn:incoming>
      <bpmn:outgoing>PRC-01.F04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="PRC-01.T03" name="Показать свободные слоты">
      <bpmn:incoming>PRC-01.F04</bpmn:incoming>
      <bpmn:outgoing>PRC-01.F05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="PRC-01.G01" name="Выбранный слот ещё свободен?">
      <bpmn:incoming>PRC-01.F05</bpmn:incoming>
      <bpmn:outgoing>PRC-01.F06</bpmn:outgoing>
      <bpmn:outgoing>PRC-01.F07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="PRC-01.T04" name="Создать запись">
      <bpmn:incoming>PRC-01.F06</bpmn:incoming>
      <bpmn:outgoing>PRC-01.F09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="PRC-01.T05" name="Отправить SMS-подтверждение">
      <bpmn:incoming>PRC-01.F09</bpmn:incoming>
      <bpmn:outgoing>PRC-01.F10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="PRC-01.T06" name="Сообщить, что слот занят">
      <bpmn:incoming>PRC-01.F07</bpmn:incoming>
      <bpmn:outgoing>PRC-01.F08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="PRC-01.E1" name="Клиент записан">
      <bpmn:incoming>PRC-01.F10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="PRC-01.F01" sourceRef="PRC-01.S" targetRef="PRC-01.T01"/>
    <bpmn:sequenceFlow id="PRC-01.F02" sourceRef="PRC-01.T01" targetRef="PRC-01.T02"/>
    <bpmn:sequenceFlow id="PRC-01.F03" sourceRef="PRC-01.T02" targetRef="PRC-01.G02"/>
    <bpmn:sequenceFlow id="PRC-01.F04" sourceRef="PRC-01.G02" targetRef="PRC-01.T03"/>
    <bpmn:sequenceFlow id="PRC-01.F05" sourceRef="PRC-01.T03" targetRef="PRC-01.G01"/>
    <bpmn:sequenceFlow id="PRC-01.F06" name="да" sourceRef="PRC-01.G01" targetRef="PRC-01.T04"/>
    <bpmn:sequenceFlow id="PRC-01.F07" name="нет" sourceRef="PRC-01.G01" targetRef="PRC-01.T06"/>
    <bpmn:sequenceFlow id="PRC-01.F08" sourceRef="PRC-01.T06" targetRef="PRC-01.G02"/>
    <bpmn:sequenceFlow id="PRC-01.F09" sourceRef="PRC-01.T04" targetRef="PRC-01.T05"/>
    <bpmn:sequenceFlow id="PRC-01.F10" sourceRef="PRC-01.T05" targetRef="PRC-01.E1"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="PRC-01.diagram">
    <bpmndi:BPMNPlane id="PRC-01.plane" bpmnElement="PRC-01.collaboration">
      <bpmndi:BPMNShape id="PRC-01.pool.di" bpmnElement="PRC-01.pool" isHorizontal="true">
        <dc:Bounds x="40" y="40" width="1780" height="420"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PRC-01.L1.di" bpmnElement="PRC-01.L1" isHorizontal="true">
        <dc:Bounds x="70" y="40" width="1750" height="140"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PRC-01.L2.di" bpmnElement="PRC-01.L2" isHorizontal="true">
        <dc:Bounds x="70" y="180" width="1750" height="280"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PRC-01.S.di" bpmnElement="PRC-01.S">
        <dc:Bounds x="187" y="92" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PRC-01.T01.di" bpmnElement="PRC-01.T01">
        <dc:Bounds x="320" y="60" width="150" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PRC-01.T02.di" bpmnElement="PRC-01.T02">
        <dc:Bounds x="510" y="60" width="150" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PRC-01.G02.di" bpmnElement="PRC-01.G02" isMarkerVisible="true">
        <dc:Bounds x="750" y="225" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PRC-01.T03.di" bpmnElement="PRC-01.T03">
        <dc:Bounds x="890" y="200" width="150" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PRC-01.G01.di" bpmnElement="PRC-01.G01" isMarkerVisible="true">
        <dc:Bounds x="1130" y="225" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PRC-01.T04.di" bpmnElement="PRC-01.T04">
        <dc:Bounds x="1270" y="200" width="150" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PRC-01.T05.di" bpmnElement="PRC-01.T05">
        <dc:Bounds x="1460" y="200" width="150" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PRC-01.T06.di" bpmnElement="PRC-01.T06">
        <dc:Bounds x="1270" y="340" width="150" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PRC-01.E1.di" bpmnElement="PRC-01.E1">
        <dc:Bounds x="1707" y="232" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="PRC-01.F01.di" bpmnElement="PRC-01.F01">
        <di:waypoint x="223" y="110"/>
        <di:waypoint x="320" y="110"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="PRC-01.F02.di" bpmnElement="PRC-01.F02">
        <di:waypoint x="470" y="110"/>
        <di:waypoint x="510" y="110"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="PRC-01.F03.di" bpmnElement="PRC-01.F03">
        <di:waypoint x="660" y="110"/>
        <di:waypoint x="705" y="110"/>
        <di:waypoint x="705" y="250"/>
        <di:waypoint x="750" y="250"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="PRC-01.F04.di" bpmnElement="PRC-01.F04">
        <di:waypoint x="800" y="250"/>
        <di:waypoint x="890" y="250"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="PRC-01.F05.di" bpmnElement="PRC-01.F05">
        <di:waypoint x="1040" y="250"/>
        <di:waypoint x="1130" y="250"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="PRC-01.F06.di" bpmnElement="PRC-01.F06">
