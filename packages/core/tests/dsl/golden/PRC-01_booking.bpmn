        <bpmndi:BPMNLabel>
          <dc:Bounds x="1210" y="230" width="30" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="PRC-01.F07.di" bpmnElement="PRC-01.F07">
        <di:waypoint x="1180" y="250"/>
