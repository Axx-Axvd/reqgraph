        <di:waypoint x="970" y="250"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="932" y="230" width="30" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="PRC-01.F07.di" bpmnElement="PRC-01.F07">
        <di:waypoint x="925" y="250"/>
        <di:waypoint x="947" y="250"/>
        <di:waypoint x="947" y="390"/>
        <di:waypoint x="970" y="390"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="943" y="370" width="30" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="PRC-01.F08.di" bpmnElement="PRC-01.F08">
        <di:waypoint x="1045" y="440"/>
        <di:waypoint x="1045" y="454"/>
        <di:waypoint x="610" y="454"/>
        <di:waypoint x="610" y="275"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="PRC-01.F09.di" bpmnElement="PRC-01.F09">
        <di:waypoint x="1120" y="250"/>
        <di:waypoint x="1160" y="250"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="PRC-01.F10.di" bpmnElement="PRC-01.F10">
