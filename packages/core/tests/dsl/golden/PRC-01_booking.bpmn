        <di:waypoint x="775" y="454"/>
        <di:waypoint x="775" y="275"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="PRC-01.F09.di" bpmnElement="PRC-01.F09">
        <di:waypoint x="1420" y="250"/>
        <di:waypoint x="1460" y="250"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="PRC-01.F10.di" bpmnElement="PRC-01.F10">
