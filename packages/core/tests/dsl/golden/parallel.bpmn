      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PRC-12.G02.di" bpmnElement="PRC-12.G02">
        <dc:Bounds x="750" y="85" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PRC-12.E.di" bpmnElement="PRC-12.E">
        <dc:Bounds x="947" y="92" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="PRC-12.F01.di" bpmnElement="PRC-12.F01">
