<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="PRC-12.definitions" targetNamespace="urn:reqgraph:process:PRC-12" exporter="reqgraph">
  <bpmn:collaboration id="PRC-12.collaboration">
    <bpmn:participant id="PRC-12.pool" name="Параллельные ветки в двух дорожках" processRef="PRC-12"/>
  </bpmn:collaboration>
  <bpmn:process id="PRC-12" name="Параллельные ветки в двух дорожках" isExecutable="false">
    <bpmn:laneSet id="PRC-12.lanes">
      <bpmn:lane id="PRC-12.L1" name="Менеджер">
        <bpmn:flowNodeRef>PRC-12.S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PRC-12.G01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PRC-12.T01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PRC-12.G02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PRC-12.E</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="PRC-12.L2" name="Склад">
        <bpmn:flowNodeRef>PRC-12.T02</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="PRC-12.S" name="Заказ получен">
      <bpmn:outgoing>PRC-12.F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="PRC-12.G01">
      <bpmn:incoming>PRC-12.F01</bpmn:incoming>
      <bpmn:outgoing>PRC-12.F02</bpmn:outgoing>
      <bpmn:outgoing>PRC-12.F03</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="PRC-12.T01" name="Выставить счёт">
      <bpmn:incoming>PRC-12.F02</bpmn:incoming>
      <bpmn:outgoing>PRC-12.F04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="PRC-12.T02" name="Зарезервировать товар">
      <bpmn:incoming>PRC-12.F03</bpmn:incoming>
      <bpmn:outgoing>PRC-12.F05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="PRC-12.G02">
      <bpmn:incoming>PRC-12.F04</bpmn:incoming>
      <bpmn:incoming>PRC-12.F05</bpmn:incoming>
      <bpmn:outgoing>PRC-12.F06</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="PRC-12.E" name="Заказ готов">
      <bpmn:incoming>PRC-12.F06</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="PRC-12.F01" sourceRef="PRC-12.S" targetRef="PRC-12.G01"/>
    <bpmn:sequenceFlow id="PRC-12.F02" sourceRef="PRC-12.G01" targetRef="PRC-12.T01"/>
    <bpmn:sequenceFlow id="PRC-12.F03" sourceRef="PRC-12.G01" targetRef="PRC-12.T02"/>
    <bpmn:sequenceFlow id="PRC-12.F04" sourceRef="PRC-12.T01" targetRef="PRC-12.G02"/>
    <bpmn:sequenceFlow id="PRC-12.F05" sourceRef="PRC-12.T02" targetRef="PRC-12.G02"/>
    <bpmn:sequenceFlow id="PRC-12.F06" sourceRef="PRC-12.G02" targetRef="PRC-12.E"/>
  </bpmn:process>
