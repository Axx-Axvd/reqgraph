<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="PRC-13.definitions" targetNamespace="urn:reqgraph:process:PRC-13" exporter="reqgraph">
  <bpmn:collaboration id="PRC-13.collaboration">
    <bpmn:participant id="PRC-13.pool" name="Старт по сообщению, узел без дорожки" processRef="PRC-13"/>
  </bpmn:collaboration>
  <bpmn:process id="PRC-13" name="Старт по сообщению, узел без дорожки" isExecutable="false">
    <bpmn:laneSet id="PRC-13.lanes">
      <bpmn:lane id="PRC-13.L1" name="Оператор">
        <bpmn:flowNodeRef>PRC-13.S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PRC-13.G01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PRC-13.T01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PRC-13.W01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PRC-13.T02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PRC-13.E</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="PRC-13.S" name="Пришла заявка">
      <bpmn:outgoing>PRC-13.F01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="PRC-13.S.def"/>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="PRC-13.G01" name="Заявка полная?">
      <bpmn:incoming>PRC-13.F01</bpmn:incoming>
      <bpmn:incoming>PRC-13.F05</bpmn:incoming>
      <bpmn:outgoing>PRC-13.F02</bpmn:outgoing>
      <bpmn:outgoing>PRC-13.F03</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="PRC-13.T01" name="Запросить данные">
      <bpmn:incoming>PRC-13.F03</bpmn:incoming>
      <bpmn:outgoing>PRC-13.F04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="PRC-13.W01" name="Через 1 день">
      <bpmn:incoming>PRC-13.F04</bpmn:incoming>
      <bpmn:outgoing>PRC-13.F05</bpmn:outgoing>
      <bpmn:timerEventDefinition id="PRC-13.W01.def">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">P1D</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="PRC-13.T02" name="Принять заявку">
      <bpmn:incoming>PRC-13.F02</bpmn:incoming>
      <bpmn:outgoing>PRC-13.F06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="PRC-13.E">
      <bpmn:incoming>PRC-13.F06</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="PRC-13.F01" sourceRef="PRC-13.S" targetRef="PRC-13.G01"/>
    <bpmn:sequenceFlow id="PRC-13.F02" name="да" sourceRef="PRC-13.G01" targetRef="PRC-13.T02"/>
    <bpmn:sequenceFlow id="PRC-13.F03" name="нет" sourceRef="PRC-13.G01" targetRef="PRC-13.T01"/>
    <bpmn:sequenceFlow id="PRC-13.F04" sourceRef="PRC-13.T01" targetRef="PRC-13.W01"/>
    <bpmn:sequenceFlow id="PRC-13.F05" sourceRef="PRC-13.W01" targetRef="PRC-13.G01"/>
    <bpmn:sequenceFlow id="PRC-13.F06" sourceRef="PRC-13.T02" targetRef="PRC-13.E"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="PRC-13.diagram">
