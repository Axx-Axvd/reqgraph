// Модель данных «Гараж 61». Id сущности графа — в Note таблицы (ENT-xx).
// Атрибут сущности адресуется как ENT-xx.<column>, например ENT-05.status.

Project garage61 {
  database_type: 'PostgreSQL'
  Note: 'Эталонный проект reqgraph (условный пример)'
}

Enum booking_status {
  confirmed [note: 'подтверждена']
  cancelled [note: 'отменена']
  no_show   [note: 'неявка']
  done      [note: 'выполнена']
}

Table client {
  id int [pk, increment]
  full_name varchar
  phone varchar [unique, not null, note: 'подтверждён SMS-кодом (FR-004)']
  created_at timestamp [not null]
  Note: 'ENT-01'
}

Table service {
  id int [pk, increment]
  title varchar [not null]
  specialization varchar [not null, note: 'какая специализация мастера нужна']
  duration_min int [not null]
  base_price numeric [not null]
  Note: 'ENT-02'
}

Table car {
  id int [pk, increment]
  plate_number varchar [unique, not null]
  model varchar
  client_id int [ref: > client.id]
  contract_id int [ref: > contract.id, note: 'заполнен для машин корпоративного автопарка']
  Note: 'ENT-03'
}

Table master {
  id int [pk, increment]
  full_name varchar [not null]
  specialization varchar [not null]
  Note: 'ENT-04'
}

Table master_shift {
  id int [pk, increment]
  master_id int [ref: > master.id, not null]
  shift_date date [not null]
  starts_at time [not null]
  ends_at time [not null]
  Note: 'ENT-08'
}

Table booking {
  id int [pk, increment]
  client_id int [ref: > client.id, not null]
  car_id int [ref: > car.id]
  service_id int [ref: > service.id, not null]
  master_id int [ref: > master.id, not null]
  starts_at timestamp [not null]
  status booking_status [not null, default: 'confirmed']
  created_at timestamp [not null]
  Note: 'ENT-05'
}

Table contract {
  id int [pk, increment]
  company_name varchar [not null]
  inn varchar [not null]
  payment_delay_days int [not null, default: 30]
  valid_until date [not null]
  Note: 'ENT-06'
}

Table invoice {
  id int [pk, increment]
  contract_id int [ref: > contract.id, not null]
  period_month date [not null, note: 'первый день месяца, за который выставлен счёт']
  amount numeric [not null]
  issued_at date [not null]
  due_date date [not null, note: 'issued_at + contract.payment_delay_days']
  Note: 'ENT-07'
}
