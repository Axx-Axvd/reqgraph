<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="PRC-05.definitions" targetNamespace="urn:reqgraph:process:PRC-05" exporter="reqgraph">
  <bpmn:collaboration id="PRC-05.collaboration">
    <bpmn:participant id="PRC-05.pool" name="Регулярные заказы и оплата офисов" processRef="PRC-05"/>
  </bpmn:collaboration>
  <bpmn:process id="PRC-05" name="Регулярные заказы и оплата офисов" isExecutable="false">
    <bpmn:laneSet id="PRC-05.lanes">
      <bpmn:lane id="PRC-05.L1" name="Офисный клиент">
        <bpmn:flowNodeRef>PRC-05.S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PRC-05.T01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PRC-05.T02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PRC-05.T03</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="PRC-05.L2" name="Система">
        <bpmn:flowNodeRef>PRC-05.G01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PRC-05.T04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PRC-05.T05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PRC-05.E1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="PRC-05.S">
      <bpmn:outgoing>PRC-05.F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="PRC-05.T01" name="Войти в систему">
      <bpmn:incoming>PRC-05.F01</bpmn:incoming>
      <bpmn:outgoing>PRC-05.F02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="PRC-05.G01" name="Выбор сценария заказа">
      <bpmn:incoming>PRC-05.F02</bpmn:incoming>
      <bpmn:outgoing>PRC-05.F03</bpmn:outgoing>
      <bpmn:outgoing>PRC-05.F04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="PRC-05.T02" name="Повторить прошлый заказ">
      <bpmn:incoming>PRC-05.F03</bpmn:incoming>
      <bpmn:outgoing>PRC-05.F05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="PRC-05.T03" name="Оформить регулярный заказ">
      <bpmn:incoming>PRC-05.F04</bpmn:incoming>
      <bpmn:outgoing>PRC-05.F06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="PRC-05.T04" name="Создать заказ на основе прошлого">
      <bpmn:incoming>PRC-05.F05</bpmn:incoming>
      <bpmn:outgoing>PRC-05.F07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="PRC-05.T05" name="Назначить оплату по счёту">
      <bpmn:incoming>PRC-05.F06</bpmn:incoming>
      <bpmn:outgoing>PRC-05.F08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="PRC-05.E1" name="Заказ офиса создан">
      <bpmn:incoming>PRC-05.F07</bpmn:incoming>
      <bpmn:incoming>PRC-05.F08</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="PRC-05.F01" sourceRef="PRC-05.S" targetRef="PRC-05.T01"/>
    <bpmn:sequenceFlow id="PRC-05.F02" sourceRef="PRC-05.T01" targetRef="PRC-05.G01"/>
    <bpmn:sequenceFlow id="PRC-05.F03" name="повторить прошлый заказ" sourceRef="PRC-05.G01" targetRef="PRC-05.T02"/>
    <bpmn:sequenceFlow id="PRC-05.F04" name="обычное оформление" sourceRef="PRC-05.G01" targetRef="PRC-05.T03"/>
    <bpmn:sequenceFlow id="PRC-05.F05" sourceRef="PRC-05.T02" targetRef="PRC-05.T04"/>
    <bpmn:sequenceFlow id="PRC-05.F06" sourceRef="PRC-05.T03" targetRef="PRC-05.T05"/>
    <bpmn:sequenceFlow id="PRC-05.F07" sourceRef="PRC-05.T04" targetRef="PRC-05.E1"/>
    <bpmn:sequenceFlow id="PRC-05.F08" sourceRef="PRC-05.T05" targetRef="PRC-05.E1"/>
  </bpmn:process>
