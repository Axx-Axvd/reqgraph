      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="PRC-02.F01.di" bpmnElement="PRC-02.F01">
        <di:waypoint x="148" y="110"/>
        <di:waypoint x="200" y="110"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="PRC-02.F02.di" bpmnElement="PRC-02.F02">
