      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PRC-02.L2.di" bpmnElement="PRC-02.L2" isHorizontal="true">
        <dc:Bounds x="70" y="180" width="1270" height="280"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PRC-02.S.di" bpmnElement="PRC-02.S">
