      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PRC-02.T03.di" bpmnElement="PRC-02.T03">
        <dc:Bounds x="680" y="340" width="150" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PRC-02.T04.di" bpmnElement="PRC-02.T04">
        <dc:Bounds x="870" y="60" width="150" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PRC-02.T05.di" bpmnElement="PRC-02.T05">
        <dc:Bounds x="1060" y="200" width="150" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PRC-02.E2.di" bpmnElement="PRC-02.E2">
