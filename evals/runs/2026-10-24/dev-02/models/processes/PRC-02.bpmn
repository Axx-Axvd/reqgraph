<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="PRC-02.definitions" targetNamespace="urn:reqgraph:process:PRC-02" exporter="reqgraph">
  <bpmn:collaboration id="PRC-02.collaboration">
    <bpmn:participant id="PRC-02.pool" name="Оформление заказа клиентом" processRef="PRC-02"/>
  </bpmn:collaboration>
  <bpmn:process id="PRC-02" name="Оформление заказа клиентом" isExecutable="false">
    <bpmn:laneSet id="PRC-02.lanes">
      <bpmn:lane id="PRC-02.L1" name="Клиент">
        <bpmn:flowNodeRef>PRC-02.S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PRC-02.T01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PRC-02.T02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PRC-02.T04</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="PRC-02.L2" name="Система">
        <bpmn:flowNodeRef>PRC-02.G01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PRC-02.E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PRC-02.T03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PRC-02.T05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PRC-02.E2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="PRC-02.S">
      <bpmn:outgoing>PRC-02.F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="PRC-02.T01" name="Выбрать интервал доставки">
      <bpmn:incoming>PRC-02.F01</bpmn:incoming>
      <bpmn:outgoing>PRC-02.F02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="PRC-02.T02" name="Выбрать способ оплаты">
      <bpmn:incoming>PRC-02.F02</bpmn:incoming>
      <bpmn:outgoing>PRC-02.F03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="PRC-02.G01" name="Проверить сумму заказа">
      <bpmn:incoming>PRC-02.F03</bpmn:incoming>
      <bpmn:outgoing>PRC-02.F04</bpmn:outgoing>
      <bpmn:outgoing>PRC-02.F05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="PRC-02.E1" name="Заказ заблокирован">
      <bpmn:incoming>PRC-02.F04</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="PRC-02.T03" name="Рассчитать стоимость доставки">
      <bpmn:incoming>PRC-02.F05</bpmn:incoming>
      <bpmn:outgoing>PRC-02.F06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="PRC-02.T04" name="Подтвердить заказ">
      <bpmn:incoming>PRC-02.F06</bpmn:incoming>
      <bpmn:outgoing>PRC-02.F07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="PRC-02.T05" name="Сохранить заказ">
      <bpmn:incoming>PRC-02.F07</bpmn:incoming>
      <bpmn:outgoing>PRC-02.F08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="PRC-02.E2" name="Заказ оформлен">
      <bpmn:incoming>PRC-02.F08</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="PRC-02.F01" sourceRef="PRC-02.S" targetRef="PRC-02.T01"/>
    <bpmn:sequenceFlow id="PRC-02.F02" sourceRef="PRC-02.T01" targetRef="PRC-02.T02"/>
    <bpmn:sequenceFlow id="PRC-02.F03" sourceRef="PRC-02.T02" targetRef="PRC-02.G01"/>
    <bpmn:sequenceFlow id="PRC-02.F04" name="сумма &lt; 700 руб." sourceRef="PRC-02.G01" targetRef="PRC-02.E1"/>
    <bpmn:sequenceFlow id="PRC-02.F05" name="сумма &gt;= 700 руб." sourceRef="PRC-02.G01" targetRef="PRC-02.T03"/>
    <bpmn:sequenceFlow id="PRC-02.F06" sourceRef="PRC-02.T03" targetRef="PRC-02.T04"/>
    <bpmn:sequenceFlow id="PRC-02.F07" sourceRef="PRC-02.T04" targetRef="PRC-02.T05"/>
    <bpmn:sequenceFlow id="PRC-02.F08" sourceRef="PRC-02.T05" targetRef="PRC-02.E2"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="PRC-02.diagram">
